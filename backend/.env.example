# ── Yousif Delivery API ──────────────────────────────────────────────
# 1) Vercel Postgres (Neon) injects POSTGRES_URL automatically when you
#    attach a database to the project (Storage → Create → Postgres).
POSTGRES_URL="postgres://user:password@host/db?sslmode=require"

# Optional aliases (the API accepts any of them, in this order):
# DATABASE_URL="postgres://..."
# POSTGRES_URL_NON_POOLING="postgres://..."

# 2) Master password for the app + API (x-app-password header).
#    Defaults to 12345678rk when this variable is missing.
APP_PASSWORD="12345678rk"
