# ── Yousif Delivery API ──────────────────────────────────────────────
# Two interchangeable backends are supported; the first one that answers wins.

# 1) Postgres — any connection string works (Vercel Postgres, Neon, Supabase).
#    Attaching a store in Vercel injects these automatically.
POSTGRES_URL="postgres://user:password@host/db?sslmode=require"
# Optional aliases (tried in this order after POSTGRES_URL):
# POSTGRES_URL_NON_POOLING="postgres://..."
# DATABASE_URL="postgres://..."
# POSTGRES_PRISMA_URL="postgres://..."

# 2) Supabase REST (PostgREST) — needs no database password at all.
#    Used when no Postgres URL is set, or when the Postgres URL is unreachable.
DELIVERY_SUPABASE_URL="https://<project-ref>.supabase.co"
DELIVERY_SUPABASE_SERVICE_KEY="<service_role key>"
# Fallbacks if the names above are missing:
# SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY

# 3) Master password for the app + API (x-app-password header).
#    Defaults to 12345678rk when this variable is missing.
APP_PASSWORD="12345678rk"
