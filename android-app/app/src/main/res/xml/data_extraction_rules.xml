<?xml version="1.0" encoding="utf-8"?>
<!--
  The phonebook, the goods list and the encrypted session must never leave the
  device through a cloud backup: a stolen account would hand over the backend
  password too. Nothing is backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
