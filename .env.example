# ---------------------------------------------------------------------------
# یوسف دلیڤەری — Environment variables
# ---------------------------------------------------------------------------
# Vercel Postgres injects POSTGRES_URL automatically when you connect a
# database to the project (Storage → Create → Postgres).
#
# Any Postgres connection string also works (Neon, Supabase, local Postgres).
# The app auto-creates its schema on the first query, so no migration step
# is required. `schema.sql` is included for CI / manual setups.
# ---------------------------------------------------------------------------

POSTGRES_URL="postgres://user:password@host:5432/db?sslmode=require"

# Optional aliases (checked in this order: POSTGRES_URL, DATABASE_URL, POSTGRES_PRISMA_URL)
# DATABASE_URL="postgres://..."
# POSTGRES_PRISMA_URL="postgres://..."

# Seed demo deliveries on first run. Recommended for local preview only.
# When no database is configured, the app uses a local JSON store (./.data)
# and seeds demo data automatically.
SEED_DEMO="false"

# Optional: protect the whole app + API with a numeric PIN (4+ digits).
# Recommended when the deployment URL is public.
# APP_PIN="1234"

# Default currency for new orders: IQD | USD
NEXT_PUBLIC_DEFAULT_CURRENCY="IQD"

# Optional: override the fallback JSON store directory (used only without a DB)
# DATA_DIR="/absolute/path/to/data"
